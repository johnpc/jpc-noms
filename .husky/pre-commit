# Quality gates — must pass before any commit lands.
# Order: lint/format (staged) -> format:check (whole tree) -> file-line discipline
#        -> feature-coverage map -> state-machine catalog -> e2e wait discipline
#        -> unit tests w/ coverage -> CRAP -> build
npx lint-staged
npm run format:check
npm run check:lines
npm run check:features
npm run check:state-machines
npm run check:e2e-waits
npm run test:coverage
npm run crap
npm run build
